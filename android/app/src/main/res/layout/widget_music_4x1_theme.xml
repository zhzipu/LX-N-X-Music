<?xml version="1.0" encoding="utf-8"?>
<!-- 主题配色样式：卡片底色 / 文字 / 进度条 / 图标颜色由 App 按当前主题动态下发（见 BaseMusicWidgetProvider.applyThemeColors）。
     圆角不画在底色上（底色是运行时 setBackgroundColor，只能方角），
     而是由外层 FrameLayout 的 outline（widget_theme_card_outline 的 20dp 圆角）+ clipToOutline 裁出来。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_theme_card_outline"
    android:clipToOutline="true">

    <!-- 主题色卡片底：颜色运行时设置，圆角靠外层裁切。
         注意必须用 FrameLayout 之类「RemoteViews 允许的控件」：
         android.view.View 没有 @RemoteView 注解，放进小组件布局会直接 InflateException
         （桌面显示「加载窗口小部件时出现问题」）。 -->
    <FrameLayout
        android:id="@+id/widget_theme_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Album art（无封面时由代码替换为音符图标；亮色卡片用深灰音符，暗色用白音符） -->
        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_ic_note"
            android:contentDescription="Album Art"
            android:clipToOutline="true"
            android:background="@drawable/widget_album_bg_transparent" />

        <!-- Right: Combined Info and Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center">

            <!-- Top: Song info -->
            <LinearLayout
                android:id="@+id/widget_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/widget_song_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LX-N-X Music"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="marquee"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_lyric_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未在播放"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:gravity="center_horizontal" />
            </LinearLayout>

            <!-- Bottom: Control buttons -->
            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <ImageButton
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/widget_ic_prev"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="Previous" />

                <ImageButton
                    android:id="@+id/widget_btn_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/widget_ic_play"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Play/Pause" />

                <ImageButton
                    android:id="@+id/widget_btn_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/widget_ic_next"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="Next" />
            </LinearLayout>

            <!-- 底部进度条：整条直接画成位图（底槽 28% 主色 + 已完成主色），由代码 setImageViewBitmap 推进度。
                 不用 ProgressBar 是因为它的颜色只能靠 tint（RemoteViews 传 ColorStateList 需要 API 31+）；
                 也不用「两个 View + setScaleX」，一是 android.view.View 不能进 RemoteViews 布局，
                 二是 setScaleX 不保证带 @RemotableViewMethod。ImageView 全版本可用。 -->
            <ImageView
                android:id="@+id/widget_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

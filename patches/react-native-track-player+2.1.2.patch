+    // ====== AudioVisualizer 专用：暴露 ExoPlayer 的 audioSessionId ======
+    // 通过 binder → getPlayback() → Player.getAudioSessionId() 拿本 app 自己的 audio session，
+    // 用于 Visualizer(sessionId) 绑定时频分析，不走麦克风、不抓系统混音。
+    @ReactMethod
+    public void getAudioSessionId(final Promise callback) {
+        try {
+            waitForConnection(() -> {
+                try {
+                    Object player = binder.getPlayback().getPlayer();
+                    if (player == null) { callback.resolve(-1); return; }
+                    // 优先走 Player.getAudioSessionId()（media3 之后版本可能直接加到此接口上）
+                    // 否则反射从 ExoPlayer / ForwardingPlayer 等具体实现上挖方法
+                    int id = -1;
+                    Class<?> c = player.getClass();
+                    // 1) 直接调用方法名
+                    try {
+                        java.lang.reflect.Method m = null;
+                        for (java.lang.reflect.Method cand : c.getMethods()) {
+                            if ("getAudioSessionId".equals(cand.getName())
+                                    && cand.getParameterCount() == 0) {
+                                m = cand; break;
+                            }
+                        }
+                        if (m != null) {
+                            m.setAccessible(true);
+                            Object r = m.invoke(player);
+                            if (r instanceof Integer) id = (Integer) r;
+                        }
+                    } catch (Throwable ignored) { id = -1; }
+                    // 2) 兜底读字段
+                    if (id <= 0) {
+                        Class<?> cc = player.getClass();
+                        while (cc != null && id <= 0) {
+                            try {
+                                java.lang.reflect.Field f = cc.getDeclaredField("audioSessionId");
+                                f.setAccessible(true);
+                                Object r = f.get(player);
+                                if (r instanceof Integer) id = (Integer) r;
+                            } catch (Throwable ignored) {}
+                            cc = cc.getSuperclass();
+                        }
+                    }
+                    callback.resolve(id > 0 ? id : -1);
+                } catch (Throwable t) {
+                    callback.resolve(-1);
+                }
+            });
+        } catch (Throwable t) {
+            callback.resolve(-1);
+        }
+    }
